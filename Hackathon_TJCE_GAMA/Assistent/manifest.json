{
  "manifest_version": 3,
  "name": "GAMA Assistente",
  "description": "Guia de Analise do Meio Ambiente - Assistente de suporte a tomada de decisao judicial (TJCE).",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Abrir GAMA Assistente"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["css/conteudo.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["sidePanel", "clipboardWrite", "storage"]
}
