{
  "manifest_version": 3,
  "name": "GAMA Assistente",
  "description": "Guia de Análise do Meio Ambiente — Assistente de suporte à tomada de decisão judicial (TJCE).",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Abrir GAMA Assistente"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "clipboardWrite"]
}
